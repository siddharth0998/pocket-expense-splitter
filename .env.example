# --- NEW RESEND EMAIL SETTINGS ---
SMTP_USER=resend
SMTP_PASSWORD=your_resend_api_key_here
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_FROM_EMAIL=hello@your_domain.com

# --- GOOGLE AUTH SETTINGS ---
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# --- BACKEND AUTH SETTINGS ---
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace_with_a_long_random_secret

# --- IMPORTANT: NEW DOMAIN URL ---
FRONTEND_URL=http://localhost:3000

# --- SAFETY LIMITS ---
MAX_RECEIPT_BYTES=5242880
MAX_RECURRING_BACKFILL_MONTHS=6

# --- DATABASE CONFIGURATION ---
POSTGRES_USER=user
POSTGRES_PASSWORD=your_super_secret_password_here
POSTGRES_DB=pocket
